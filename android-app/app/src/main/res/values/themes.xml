<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light on Android 8-9; values-v29 switches to DayNight. -->
    <style name="Theme.Zaptun.Base" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

    <style name="Theme.Zaptun" parent="Theme.Zaptun.Base">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:colorAccent">@color/zap_blue</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@android:style/TextAppearance.DeviceDefault.Medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Tappable title row of a collapsible card: title, summary, chevron. -->
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="SectionTitle" parent="CardTitle">
        <item name="android:layout_width">wrap_content</item>
    </style>

    <style name="SectionSummary">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">8dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="SectionChevron">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:src">@drawable/ic_chevron</item>
    </style>

    <style name="Hint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textAppearance">@android:style/TextAppearance.DeviceDefault.Small</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
</resources>
