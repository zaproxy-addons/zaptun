<?xml version="1.0" encoding="utf-8"?>
<!-- The wrapper takes the system-bar insets, so the scroll view keeps its own padding. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- fillViewport + center_vertical: a short page sits in the middle, a long one scrolls. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="90dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:contentDescription="@null"
                android:src="@drawable/logo" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textAppearance="@android:style/TextAppearance.DeviceDefault.Large"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/proxy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:padding="4dp"
                android:textColor="?android:attr/textColorSecondary" />

            <Button
                android:id="@+id/toggle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Certificate trust -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/certificate" />

                <TextView
                    android:id="@+id/system_trust"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:text="@string/system_trust" />

                <TextView
                    android:id="@+id/user_trust"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:text="@string/user_trust" />

                <TextView
                    android:id="@+id/trust_hint"
                    style="@style/Hint" />
            </LinearLayout>

            <!-- Ports (collapsible) -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:id="@+id/ports_header"
                    style="@style/SectionHeader">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="@string/ports" />

                    <TextView
                        android:id="@+id/ports_summary"
                        style="@style/SectionSummary" />

                    <ImageView
                        android:id="@+id/ports_chevron"
                        style="@style/SectionChevron"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ports_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <dev.davidjosearaujo.zaptun.FlowLayout
                        android:id="@+id/ports"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/new_port"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:digits="0123456789, "
                            android:hint="@string/add_port_hint"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/add_port"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/chip"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="6dp"
                            android:text="@string/add_port"
                            android:textColor="?android:attr/textColorPrimary" />
                    </LinearLayout>

                    <TextView
                        style="@style/Hint"
                        android:text="@string/ports_hint" />

                    <Switch
                        android:id="@+id/all_ports"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/all_ports" />

                    <TextView
                        style="@style/Hint"
                        android:text="@string/all_ports_hint" />

                    <TextView
                        android:id="@+id/restore_ports"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/chip"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="6dp"
                        android:text="@string/restore_ports"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Apps (collapsible) -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:id="@+id/apps_header"
                    style="@style/SectionHeader">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="@string/apps" />

                    <TextView
                        android:id="@+id/apps_summary"
                        style="@style/SectionSummary" />

                    <ImageView
                        android:id="@+id/apps_chevron"
                        style="@style/SectionChevron"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/apps_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Switch
                        android:id="@+id/all_apps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/all_apps" />

                    <CheckBox
                        android:id="@+id/system_apps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/show_system_apps" />

                    <TextView
                        android:id="@+id/apps_hint"
                        style="@style/Hint" />

                    <LinearLayout
                        android:id="@+id/apps_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <!-- Activity (collapsible): recent connections and what was refused -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:id="@+id/activity_header"
                    style="@style/SectionHeader">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="@string/activity" />

                    <TextView
                        android:id="@+id/activity_summary"
                        style="@style/SectionSummary" />

                    <ImageView
                        android:id="@+id/activity_chevron"
                        style="@style/SectionChevron"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/activity_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/activity_stats"
                        style="@style/Hint"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/activity_empty"
                        style="@style/Hint"
                        android:text="@string/activity_empty" />

                    <LinearLayout
                        android:id="@+id/activity_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/activity_clear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/chip"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="6dp"
                        android:text="@string/activity_clear"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/restore_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/chip"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:text="@string/restore_all"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
